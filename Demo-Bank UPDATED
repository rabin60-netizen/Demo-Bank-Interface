def balance():
     amount=amt_reader()
     print(f"Your current balance is Rs.{amount:,}")

def deposite():
   print("Enter the amount: ")
   new_amt=0
   new_amt+=getnum()
   corrector_add(new_amt)
   print("Deposited successfully")

def transfer():
    print("Enter the amount: ")
    enter_amt=getnum()
    amount=amt_reader()
    while enter_amt>amount:
         print("Insufficient Balance")
         enter_amt=getnum()
       
    corrector_sub(enter_amt)
    print("Transferred successfully")
    

def Widthdraw():
    print("Enter the amount: ")
    enter_amt=getnum()
    amount=amt_reader()
    while enter_amt>amount:
        print("Insufficient Balance")
        enter_amt=getnum()
           
    corrector_sub(enter_amt)
    print("Widthdrawed successfully")

def getnum():
    while True:
        try:
            y=int(input("-->"))
        except ValueError:
            print("Try again!")
        else:
            return y

def corrector_add(a):
    old_amt=amt_reader()
    new_amt=a+old_amt
    with open("bank.txt","w") as f:
         f.write(str(new_amt))

def corrector_sub(a):
    with open("bank.txt","r") as f:
        old_amt=int(f.read())
    new_amt=old_amt-a
    with open("bank.txt","w") as f:
        f.write(str(new_amt))

def amt_reader():
    with open("bank.txt","r") as f: 
        return int(f.read())

